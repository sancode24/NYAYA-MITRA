# Required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: defaults to gemini-2.5-flash-lite (lighter free-tier usage). See:
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: reduce 429 rate-limit errors (free tier)
# GEMINI_MAX_RETRIES=4
# GEMINI_MAX_EXCERPT_CHARS=3200
# GEMINI_MAX_HISTORY_MESSAGES=8

# Cross-encoder reranking (better relevance than bi-encoder alone; downloads a 2nd model)
# USE_CROSS_ENCODER=true
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# BI_ENCODER_POOL=24
# CROSS_ENCODER_MAX_PASSAGE_CHARS=2000

# Path to BNS 2023 PDF (copy here or point to your file)
BNS_PDF_PATH=C:\Users\sruja\AppData\Roaming\Cursor\User\workspaceStorage\99410877df45f6fb70a48715adb79569\pdfs\bf2616b0-dfeb-4843-bdad-fe02952a67e0\BNS2023.pdf

# Folder for embeddings.npy + chunks.jsonl
INDEX_DIR=./bns_index
